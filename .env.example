# Staging Supabase — values are owner-held, handed at dispatch, never committed.
# Copy this file to .env (gitignored) and fill both in.
# EXPO_PUBLIC_* values are embedded into client bundles by Expo at build time:
# only publishable-class keys belong here, never secret-class keys.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
