# Dependencies
node_modules/

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Native build output
ios/
android/
*.ipa
*.apk
*.aab

# EAS
.easignore

# Environment and secrets — never commit these
# Literal .env* (REVIEW-008 finding 3): covers .env, dot-suffix forms, and
# non-conventional names like .envrc or .envfoo; only .env.example is negated.
.env*
!.env.example
*.pem
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.cache/
.turbo/
.eslintcache
*.tsbuildinfo

# Testing
coverage/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
